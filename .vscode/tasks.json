{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "problemMatcher": "$vite"
    },
    {
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Built site served at \\S+",
          "endsPattern": "Built site served at \\S+"
        }
      },
      "isBackground": true
    },
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "press \\S+ to show help",
          "endsPattern": "press \\S+ to show help"
        }
      },
      "isBackground": true
    }
  ]
}
